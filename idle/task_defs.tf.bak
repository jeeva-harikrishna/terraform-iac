resource "aws_ecs_task_definition" "kafka_connect_task_fixed_r6" {
  family                   = "kafka-connect-task-fixed"
  network_mode             = "awsvpc"
  cpu                      = "1024"
  memory                   = "2048"
  execution_role_arn       = "arn:aws:iam::842676018479:role/SecurityECSTaskExecutionRole"
  task_role_arn            = "arn:aws:iam::842676018479:role/SecurityECSTaskRole"
  requires_compatibilities = ["FARGATE"]
  container_definitions    = <<CONTAINER_DEF
[
  {
    "name": "kafka-connect",
    "image": "842676018479.dkr.ecr.us-east-2.amazonaws.com/kafka:connect-2.5",
    "cpu": 0,
    "memory": 0,
    "essential": true,
    "portMappings": [
      {
        "containerPort": 8083,
        "hostPort": 8083,
        "protocol": "tcp"
      }
    ],
    "environment": [
      {
        "name": "REST_HOST_NAME",
        "value": "0.0.0.0"
      },
      {
        "name": "OFFSET_STORAGE_TOPIC",
        "value": "connect_offsets"
      },
      {
        "name": "VALUE_CONVERTER_SCHEMAS_ENABLE",
        "value": "false"
      },
      {
        "name": "BOOTSTRAP_SERVERS",
        "value": "kafka.kafka.internal:9092"
      },
      {
        "name": "KEY_CONVERTER",
        "value": "org.apache.kafka.connect.json.JsonConverter"
      },
      {
        "name": "KEY_CONVERTER_SCHEMAS_ENABLE",
        "value": "false"
      },
      {
        "name": "CONFIG_STORAGE_REPLICATION_FACTOR",
        "value": "1"
      },
      {
        "name": "STATUS_STORAGE_REPLICATION_FACTOR",
        "value": "1"
      },
      {
        "name": "GROUP_ID",
        "value": "connect-cluster"
      },
      {
        "name": "REST_PORT",
        "value": "8083"
      },
      {
        "name": "STATUS_STORAGE_TOPIC",
        "value": "connect_statuses"
      },
      {
        "name": "CONFIG_STORAGE_TOPIC",
        "value": "connect_configs"
      },
      {
        "name": "OFFSET_STORAGE_REPLICATION_FACTOR",
        "value": "1"
      },
      {
        "name": "VALUE_CONVERTER",
        "value": "org.apache.kafka.connect.json.JsonConverter"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/kafka-connect-task",
        "awslogs-region": "us-east-2",
        "awslogs-stream-prefix": "ecs"
      }
    }
  }
]
CONTAINER_DEF
  lifecycle {
    ignore_changes = [container_definitions]
  }
}

resource "aws_ecs_task_definition" "kafka_task_r2" {
  family                   = "kafka-task"
  network_mode             = "awsvpc"
  cpu                      = "1024"
  memory                   = "2048"
  execution_role_arn       = "arn:aws:iam::842676018479:role/SecurityECSTaskExecutionRole"
  task_role_arn            = "arn:aws:iam::842676018479:role/SecurityECSTaskRole"
  requires_compatibilities = ["FARGATE"]
  container_definitions    = <<CONTAINER_DEF
[
  {
    "name": "kafka",
    "image": "842676018479.dkr.ecr.us-east-2.amazonaws.com/kafka:broker-7.5.0",
    "cpu": 0,
    "memory": 0,
    "essential": true,
    "portMappings": [
      {
        "containerPort": 9092,
        "hostPort": 9092,
        "protocol": "tcp"
      },
      {
        "containerPort": 29092,
        "hostPort": 29092,
        "protocol": "tcp"
      },
      {
        "containerPort": 8080,
        "hostPort": 8080,
        "protocol": "tcp"
      }
    ],
    "environment": [
      {
        "name": "KAFKA_BROKER_ID",
        "value": "1"
      },
      {
        "name": "KAFKA_ADVERTISED_LISTENERS",
        "value": "PLAINTEXT_INTERNAL://kafka.kafka.internal:29092,PLAINTEXT://kafka.kafka.internal:9092"
      },
      {
        "name": "KAFKA_LOG_RETENTION_HOURS",
        "value": "72"
      },
      {
        "name": "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR",
        "value": "1"
      },
      {
        "name": "KAFKA_ZOOKEEPER_CONNECT",
        "value": "zookeeper.kafka.internal:2181"
      },
      {
        "name": "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR",
        "value": "1"
      },
      {
        "name": "KAFKA_LISTENERS",
        "value": "PLAINTEXT_INTERNAL://0.0.0.0:29092,PLAINTEXT://0.0.0.0:9092"
      },
      {
        "name": "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR",
        "value": "1"
      },
      {
        "name": "KAFKA_INTER_BROKER_LISTENER_NAME",
        "value": "PLAINTEXT_INTERNAL"
      },
      {
        "name": "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP",
        "value": "PLAINTEXT:PLAINTEXT,PLAINTEXT_INTERNAL:PLAINTEXT"
      },
      {
        "name": "KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS",
        "value": "0"
      },
      {
        "name": "KAFKA_AUTO_CREATE_TOPICS_ENABLE",
        "value": "true"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/kafka-task",
        "awslogs-region": "us-east-2",
        "awslogs-stream-prefix": "ecs"
      }
    }
  }
]
CONTAINER_DEF
  lifecycle {
    ignore_changes = [container_definitions]
  }
}

